# Copie para .env (ignorado pelo git) e preencha. No servidor, defina as mesmas variáveis no painel da hospedagem.
# Segredos ficam aqui, nunca na tela do sistema nem no banco.

# Telegram: token do bot (do @BotFather). Quem recebe os alertas é aprovado em Configurações > Alertas.
TELEGRAM_BOT_TOKEN=

# Drive via Apps Script: segredo (mín. 24 caracteres, o mesmo da propriedade SEGREDO do script) e URL do App da Web do script.
DRIVE_SCRIPT_SEGREDO=
DRIVE_SCRIPT_URL=

# Modo teste local (ignorado em produção): permite enviar o fechamento com cadastro incompleto.
# MODO_TESTE_LOCAL=1
