[Unit]
Description=Pagamento Motoboys
After=network.target

[Service]
User=motoboys
WorkingDirectory=/opt/motoboys
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/opt/motoboys/data
Environment=COOKIE_SECURE=1
# Opcional: variáveis extras (ex.: TZ_ALERTAS). E-mail e alertas se configuram na tela Configurações.
EnvironmentFile=-/etc/motoboys.env
ExecStart=/usr/bin/node server.js
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/motoboys/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
